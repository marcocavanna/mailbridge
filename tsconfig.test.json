{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    /* Con `noEmit` non si scrive niente su disco: la radice si allarga a tutta la repo così i test
     * e i file di configurazione entrano nel programma. */
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
